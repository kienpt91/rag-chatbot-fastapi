# Settings for scripts/eval-real.sh. Copy to eval/real.env (ignored by git) and fill in. Nothing here is a real key.
RAG_PROVIDER=http
RAG_API_BASE_URL=https://api.example.com/v1
RAG_API_KEY=put-your-key-here
RAG_CHAT_MODEL=your-chat-model
RAG_EMBEDDING_MODEL=your-embedding-model
RAG_EMBEDDING_DIMENSIONS=1536
# a price table that lists both models (see examples/prices.example.json), mounted inside the repository
RAG_PRICE_TABLE_FILE=/work/examples/prices.example.json
# tune this on the dataset: the highest value that still answers every answerable case
RAG_CONFIDENCE_THRESHOLD=0.30
