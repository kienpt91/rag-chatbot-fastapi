# Copy to .env (git-ignored). Every value here is a placeholder: nothing in this file is a real credential.
RAG_DB_ADMIN_PASSWORD=change-me-admin
RAG_DB_PASSWORD=change-me-service
# fake = a deterministic stand-in, no hosted model and no cost; http = a real chat/embedding API
RAG_PROVIDER=fake
RAG_CONFIDENCE_THRESHOLD=0.10
# with RAG_PROVIDER=http:
# RAG_API_BASE_URL=https://api.example.com/v1
# RAG_API_KEY=put-your-key-here
# RAG_CHAT_MODEL=your-chat-model
# RAG_EMBEDDING_MODEL=your-embedding-model
# RAG_EMBEDDING_DIMENSIONS=1536
